# AACP — uygulama build değişkenleri (react-native-config)
#
# Kullanım: bu dosyayı `.env` olarak kopyalayın ve doldurun. Değerler build
# zamanında gömülür; değişiklik sonrası uygulamayı YENİDEN DERLEYİN
# (Metro'yu yeniden başlatmak yetmez).
#
# Hepsi opsiyoneldir: verilmeyen her değer src/core/config/env.ts içindeki
# ortam preset'inden gelir. Yani `.env` olmadan da uygulama çalışır.

# Aktif ortam: development | staging | production
APP_ENV=development

# API adresi (Cloudflare Workers). BOŞSA sunucu gerektiren her şey (senkron,
# hesap, telemetri) sessizce kapanır ve uygulama tamamen yerel çalışır.
# Örn: https://aacp-api.<hesabın>.workers.dev
# Kurulum: docs/CLOUDFLARE-SUPABASE-KURULUM.md
APP_API_BASE_URL=https://aacp-api.tahabasegmez.workers.dev

# Uzak şov kataloğu (shows.json). Boşsa koda gömülü liste kullanılır.
APP_CATALOG_URL=

# Bölüm kaynağı: rss (varsayılan) | transistor
APP_EPISODE_SOURCE=rss

# Transistor API anahtarı — yalnızca APP_EPISODE_SOURCE=transistor ise gerekir.
# Anahtarı uygulamaya gömmek yerine sunucu proxy'sini kullanmak önerilir.
APP_TRANSISTOR_API_KEY=

# VAST reklam etiketi. BOŞSA reklam sistemi tamamen kapalıdır (bkz. docs/REKLAM.md).
# Yer tutucular: {placement} {episodeId} {showId} {duration} {timestamp} {random}
APP_AD_TAG_URL=
