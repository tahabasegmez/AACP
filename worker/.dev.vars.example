# Yerel geliştirme gizli değerleri (wrangler dev).
#
# Bu dosyayı `.dev.vars` olarak kopyalayın ve doldurun — `.dev.vars` git'e
# GİRMEZ. Yayınlanan Worker bu dosyayı kullanmaz; orada değerler
# `wrangler secret put <AD>` ile eklenir.
#
# Ayrıntı: docs/CLOUDFLARE-SUPABASE-KURULUM.md

# Supabase → Project Settings → API
SUPABASE_ANON_KEY=
# GİZLİ: RLS'i bypass eder, yalnızca yönetim işlerinde kullanılır.
SUPABASE_SERVICE_KEY=
# GİZLİ: kullanıcı jetonlarını doğrulamak için (Settings → API → JWT Settings).
SUPABASE_JWT_SECRET=

# Yönetim uçlarını korur (katalog yayınlama, feed tarama).
# Üretmek için: openssl rand -hex 24
#
# Yönetim BETİKLERİ de bu dosyadan okur (scripts/admin.mjs). Jetonu uygulamanın
# kök `.env`'ine YAZMAYIN: react-native-config oradaki her değişkeni derlenen
# IPA'ya gömer ve jeton uygulamayla birlikte dağıtılır.
ADMIN_TOKEN=
# Yönetim betiklerinin hedefi (ör. https://aacp-api.<hesap>.workers.dev).
API_URL=


# APNs (opsiyonel) — boşsa bildirim gönderilmez, tarama yine çalışır.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
