# AACP backend yapılandırması — bu dosyayı `.env` olarak kopyalayıp doldurun.
# Hiçbir değer makineye özgü değildir; aynı dosya her sunucuda çalışır.

# --- ağ ---------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# --- kalıcılık --------------------------------------------------------------
# sqlite (varsayılan, tek dosya) veya memory (test/geçici)
STORAGE_DRIVER=sqlite
DATA_DIR=/data

# --- güvenlik ---------------------------------------------------------------
# ZORUNLU (üretim): jeton imzalama anahtarı. Üretmek için:
#   openssl rand -hex 32
AUTH_SECRET=

# Oturum ömrü (saniye) — varsayılan 30 gün
TOKEN_TTL_SEC=2592000

# Katalog yayınlama (POST /v1/catalog) için anahtar.
# Boş bırakılırsa yönetim uçları tamamen KAPALIDIR.
ADMIN_TOKEN=

# Virgülle ayrılmış izinli kökenler (web istemci eklenirse). Boş = CORS kapalı.
CORS_ORIGINS=

# Dakikada IP başına istek sınırı
RATE_LIMIT_PER_MIN=120

# --- entegrasyonlar ---------------------------------------------------------
# Transistor API anahtarı. Verilirse /v1/transistor/* proxy'si açılır ve
# anahtar istemciye hiç gitmez.
TRANSISTOR_API_KEY=
TRANSISTOR_BASE_URL=https://api.transistor.fm/v1

# Telemetri toplama
ANALYTICS_ENABLED=true

# --- push bildirimleri ------------------------------------------------------
# Takip edilen şovlarda yeni bölüm taraması aralığı (ms). 0 → kapalı.
# Varsayılan 30 dakika. Elle tetiklemek için: POST /v1/push/scan (admin)
FEED_WATCH_INTERVAL_MS=1800000
